{
  "tests": [
    {
      "input": "args = [[5,4,3,2,1]]",
      "expectedOutput": {
        "javascript": "0",
        "python": "0",
        "java": "0"
      }
    },
    {
      "input": "args = [[1]]",
      "expectedOutput": {
        "javascript": "0",
        "python": "0",
        "java": "0"
      }
    },
    {
      "input": "args = [[2,1]]",
      "expectedOutput": {
        "javascript": "0",
        "python": "0",
        "java": "0"
      }
    },
    {
      "input": "args = [[1,2]]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    },
    {
      "input": "args = [[3,2,6,5,0,3]]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    },
    {
      "input": "args = [[2,4,1]]",
      "expectedOutput": {
        "javascript": "2",
        "python": "2",
        "java": "2"
      }
    },
    {
      "input": "args = [[1,5,3,6,4]]",
      "expectedOutput": {
        "javascript": "5",
        "python": "5",
        "java": "5"
      }
    },
    {
      "input": "args = [[10,1,5,6,7,1]]",
      "expectedOutput": {
        "javascript": "6",
        "python": "6",
        "java": "6"
      }
    },
    {
      "input": "args = [[6,1,3,2,4,7]]",
      "expectedOutput": {
        "javascript": "6",
        "python": "6",
        "java": "6"
      }
    },
    {
      "input": "args = [[1,4,2]]",
      "expectedOutput": {
        "javascript": "3",
        "python": "3",
        "java": "3"
      }
    },
    {
      "input": "args = [[3,3,5,0,0,3,1,4]]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    },
    {
      "input": "args = [[2,1,2,1,0,1,2]]",
      "expectedOutput": {
        "javascript": "2",
        "python": "2",
        "java": "2"
      }
    }
  ]
}
