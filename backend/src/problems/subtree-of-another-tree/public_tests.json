{
  "tests": [
    {
      "input": "args = [[3,4,5,1,2],[4,1,2]]",
      "expectedOutput": {
        "javascript": "true",
        "python": "True",
        "java": "true"
      }
    },
    {
      "input": "args = [[3,4,5,1,2,null,null,null,null,0],[4,1,2]]",
      "expectedOutput": {
        "javascript": "false",
        "python": "False",
        "java": "false"
      }
    },
    {
      "input": "args = [[1],[1]]",
      "expectedOutput": {
        "javascript": "true",
        "python": "True",
        "java": "true"
      }
    }
  ],
  "combinedExpectedOutput": {
    "javascript": "true\nfalse\ntrue",
    "python": "True\nFalse\nTrue",
    "java": "true\nfalse\ntrue"
  }
}
