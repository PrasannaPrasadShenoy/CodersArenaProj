{
  "tests": [
    {
      "input": "args = [[0]]",
      "expectedOutput": {
        "javascript": "0",
        "python": "0",
        "java": "0"
      }
    },
    {
      "input": "args = [[-1]]",
      "expectedOutput": {
        "javascript": "-1",
        "python": "-1",
        "java": "-1"
      }
    },
    {
      "input": "args = [[2,-1,3]]",
      "expectedOutput": {
        "javascript": "3",
        "python": "3",
        "java": "3"
      }
    },
    {
      "input": "args = [[-2,-3]]",
      "expectedOutput": {
        "javascript": "6",
        "python": "6",
        "java": "6"
      }
    },
    {
      "input": "args = [[1,2,3,4]]",
      "expectedOutput": {
        "javascript": "24",
        "python": "24",
        "java": "24"
      }
    },
    {
      "input": "args = [[-1,-2,-3]]",
      "expectedOutput": {
        "javascript": "6",
        "python": "6",
        "java": "6"
      }
    },
    {
      "input": "args = [[0,2]]",
      "expectedOutput": {
        "javascript": "2",
        "python": "2",
        "java": "2"
      }
    },
    {
      "input": "args = [[3,-1,4]]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    },
    {
      "input": "args = [[-2,3,-4]]",
      "expectedOutput": {
        "javascript": "24",
        "python": "24",
        "java": "24"
      }
    },
    {
      "input": "args = [[2,3,-2,4,-1]]",
      "expectedOutput": {
        "javascript": "48",
        "python": "48",
        "java": "48"
      }
    },
    {
      "input": "args = [[1,0,-1,2,3]]",
      "expectedOutput": {
        "javascript": "6",
        "python": "6",
        "java": "6"
      }
    },
    {
      "input": "args = [[-3,0,1,-2]]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    }
  ]
}
