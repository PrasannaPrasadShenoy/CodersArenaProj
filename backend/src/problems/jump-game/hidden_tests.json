        "java": "true"
      }
    },
    {
      "input": "args = [[1,1,1,0]]",
      "expectedOutput": {
        "javascript": "true",
        "python": "True",
        "java": "true"
      }
    },
    {
      "input": "args = [[3,0,8,2,0,0,1]]",
      "expectedOutput": {
