{
  "tests": [
    {
      "input": "args = [[-3]]",
      "expectedOutput": {
        "javascript": "-3",
        "python": "-3",
        "java": "-3"
      }
    },
    {
      "input": "args = [[1,-2,3]]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    },
    {
      "input": "args = [[5,4,8,11,null,13,4,7,2,null,null,null,1]]",
      "expectedOutput": {
        "javascript": "48",
        "python": "48",
        "java": "48"
      }
    },
    {
      "input": "args = [[1,2,3,4,5]]",
      "expectedOutput": {
        "javascript": "11",
        "python": "11",
        "java": "11"
      }
    },
    {
      "input": "args = [[-1,-2,-3]]",
      "expectedOutput": {
        "javascript": "-1",
        "python": "-1",
        "java": "-1"
      }
    },
    {
      "input": "args = [[1,-1,2]]",
      "expectedOutput": {
        "javascript": "3",
        "python": "3",
        "java": "3"
      }
    },
    {
      "input": "args = [[1,2,-3,4,5]]",
      "expectedOutput": {
        "javascript": "11",
        "python": "11",
        "java": "11"
      }
    },
    {
      "input": "args = [[1,2,3,null,null,4,5]]",
      "expectedOutput": {
        "javascript": "12",
        "python": "12",
        "java": "12"
      }
    },
    {
      "input": "args = [[-1,2,3]]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    },
    {
      "input": "args = [[1,-2,-3,1,3,-2,null,-1]]",
      "expectedOutput": {
        "javascript": "3",
        "python": "3",
        "java": "3"
      }
    },
    {
      "input": "args = [[2,-1]]",
      "expectedOutput": {
        "javascript": "2",
        "python": "2",
        "java": "2"
      }
    },
    {
      "input": "args = [[1,2]]",
      "expectedOutput": {
        "javascript": "3",
        "python": "3",
        "java": "3"
      }
    }
  ]
}
