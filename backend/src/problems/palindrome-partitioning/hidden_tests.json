    },
    {
      "input": "args = [\"noon\"]",
      "expectedOutput": {
        "javascript": "[[\"n\",\"o\",\"o\",\"n\"],[\"n\",\"oo\",\"n\"],[\"noon\"]]",
        "python": "[[\"n\", \"o\", \"o\", \"n\"], [\"n\", \"oo\", \"n\"], [\"noon\"]]",
        "java": "[[\"n\", \"o\", \"o\", \"n\"], [\"n\", \"oo\", \"n\"], [\"noon\"]]"
      }
