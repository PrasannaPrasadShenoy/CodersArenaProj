{
  "tests": [
    {
      "input": "args = [[1],1]",
      "expectedOutput": {
        "javascript": "0",
        "python": "0",
        "java": "0"
      }
    },
    {
      "input": "args = [[3,1],1]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    },
    {
      "input": "args = [[1,3],3]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    },
    {
      "input": "args = [[2,1],2]",
      "expectedOutput": {
        "javascript": "0",
        "python": "0",
        "java": "0"
      }
    },
    {
      "input": "args = [[5,1,3],3]",
      "expectedOutput": {
        "javascript": "2",
        "python": "2",
        "java": "2"
      }
    },
    {
      "input": "args = [[4,5,6,7,8,1,2,3],8]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    },
    {
      "input": "args = [[6,7,0,1,2,3,4,5],6]",
      "expectedOutput": {
        "javascript": "0",
        "python": "0",
        "java": "0"
      }
    },
    {
      "input": "args = [[7,0,1,2,3,4,5,6],7]",
      "expectedOutput": {
        "javascript": "0",
        "python": "0",
        "java": "0"
      }
    },
    {
      "input": "args = [[0,1,2,3,4,5,6,7],4]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    },
    {
      "input": "args = [[3,4,5,6,7,0,1,2],2]",
      "expectedOutput": {
        "javascript": "7",
        "python": "7",
        "java": "7"
      }
    },
    {
      "input": "args = [[9,0,2,7,8],3]",
      "expectedOutput": {
        "javascript": "-1",
        "python": "-1",
        "java": "-1"
      }
    },
    {
      "input": "args = [[8,9,2,3,4],9]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    }
  ]
}
