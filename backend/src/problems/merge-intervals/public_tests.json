        "java": "[[1, 7]]"
      }
    }
  ],
  "combinedExpectedOutput": {
    "javascript": "[[1,6],[8,10],[15,18]]\n[[1,5]]\n[[1,7]]",
    "python": "[[1, 6], [8, 10], [15, 18]]\n[[1, 5]]\n[[1, 7]]",
