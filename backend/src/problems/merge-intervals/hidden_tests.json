{
  "tests": [
    {
      "input": "args = [[[1,3]]]",
      "expectedOutput": {
        "javascript": "[[1,3]]",
        "python": "[[1, 3]]",
        "java": "[[1, 3]]"
      }
    },
    {
      "input": "args = [[[1,4],[2,3]]]",
      "expectedOutput": {
        "javascript": "[[1,4]]",
        "python": "[[1, 4]]",
        "java": "[[1, 4]]"
      }
    },
    {
      "input": "args = [[[1,2],[3,4],[5,6]]]",
      "expectedOutput": {
        "javascript": "[[1,2],[3,4],[5,6]]",
        "python": "[[1, 2], [3, 4], [5, 6]]",
        "java": "[[1, 2], [3, 4], [5, 6]]"
      }
    },
    {
      "input": "args = [[[0,0]]]",
      "expectedOutput": {
        "javascript": "[[0,0]]",
        "python": "[[0, 0]]",
        "java": "[[0, 0]]"
      }
    },
    {
      "input": "args = [[[1,10],[2,3],[4,5],[6,7],[8,9]]]",
      "expectedOutput": {
        "javascript": "[[1,10]]",
        "python": "[[1, 10]]",
        "java": "[[1, 10]]"
      }
    },
    {
      "input": "args = [[[1,3],[2,6],[8,10],[9,12],[15,18]]]",
      "expectedOutput": {
        "javascript": "[[1,6],[8,12],[15,18]]",
        "python": "[[1, 6], [8, 12], [15, 18]]",
        "java": "[[1, 6], [8, 12], [15, 18]]"
      }
    },
    {
      "input": "args = [[[2,3],[4,5],[6,7],[8,9],[1,10]]]",
      "expectedOutput": {
        "javascript": "[[1,10]]",
        "python": "[[1, 10]]",
        "java": "[[1, 10]]"
      }
    },
    {
      "input": "args = [[[1,4],[0,4]]]",
      "expectedOutput": {
        "javascript": "[[0,4]]",
        "python": "[[0, 4]]",
        "java": "[[0, 4]]"
      }
    },
    {
      "input": "args = [[[1,4],[0,0],[3,5]]]",
      "expectedOutput": {
        "javascript": "[[0,0],[1,5]]",
        "python": "[[0, 0], [1, 5]]",
        "java": "[[0, 0], [1, 5]]"
      }
    }
  ]
}
