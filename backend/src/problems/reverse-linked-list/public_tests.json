{
  "tests": [
    {
      "input": "args = [[1,2,3,4,5]]",
      "expectedOutput": {
        "javascript": "[5,4,3,2,1]",
        "python": "[5, 4, 3, 2, 1]",
        "java": "[5, 4, 3, 2, 1]"
      }
    },
    {
      "input": "args = [[1,2]]",
      "expectedOutput": {
        "javascript": "[2,1]",
        "python": "[2, 1]",
        "java": "[2, 1]"
      }
    },
    {
      "input": "args = [[1]]",
      "expectedOutput": {
        "javascript": "[1]",
        "python": "[1]",
        "java": "[1]"
      }
    }
  ],
  "combinedExpectedOutput": {
    "javascript": "[5,4,3,2,1]\n[2,1]\n[1]",
    "python": "[5, 4, 3, 2, 1]\n[2, 1]\n[1]",
    "java": "[5, 4, 3, 2, 1]\n[2, 1]\n[1]"
  }
}
