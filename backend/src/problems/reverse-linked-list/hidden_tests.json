{
  "tests": [
    {
      "input": "args = [[]]",
      "expectedOutput": {
        "javascript": "[]",
        "python": "[]",
        "java": "[]"
      }
    },
    {
      "input": "args = [[1,2,3]]",
      "expectedOutput": {
        "javascript": "[3,2,1]",
        "python": "[3, 2, 1]",
        "java": "[3, 2, 1]"
      }
    },
    {
      "input": "args = [[1,2,3,4]]",
      "expectedOutput": {
        "javascript": "[4,3,2,1]",
        "python": "[4, 3, 2, 1]",
        "java": "[4, 3, 2, 1]"
      }
    },
    {
      "input": "args = [[-1,-2,-3]]",
      "expectedOutput": {
        "javascript": "[-3,-2,-1]",
        "python": "[-3, -2, -1]",
        "java": "[-3, -2, -1]"
      }
    },
    {
      "input": "args = [[0]]",
      "expectedOutput": {
        "javascript": "[0]",
        "python": "[0]",
        "java": "[0]"
      }
    },
    {
      "input": "args = [[5000,-5000]]",
      "expectedOutput": {
        "javascript": "[-5000,5000]",
        "python": "[-5000, 5000]",
        "java": "[-5000, 5000]"
      }
    },
    {
      "input": "args = [[1,1,1]]",
      "expectedOutput": {
        "javascript": "[1,1,1]",
        "python": "[1, 1, 1]",
        "java": "[1, 1, 1]"
      }
    },
    {
      "input": "args = [[10,20,30,40,50,60]]",
      "expectedOutput": {
        "javascript": "[60,50,40,30,20,10]",
        "python": "[60, 50, 40, 30, 20, 10]",
        "java": "[60, 50, 40, 30, 20, 10]"
      }
    },
    {
      "input": "args = [[-100,0,100]]",
      "expectedOutput": {
        "javascript": "[100,0,-100]",
        "python": "[100, 0, -100]",
        "java": "[100, 0, -100]"
      }
    },
    {
      "input": "args = [[7]]",
      "expectedOutput": {
        "javascript": "[7]",
        "python": "[7]",
        "java": "[7]"
      }
    },
    {
      "input": "args = [[1,2,3,4,5,6,7]]",
      "expectedOutput": {
        "javascript": "[7,6,5,4,3,2,1]",
        "python": "[7, 6, 5, 4, 3, 2, 1]",
        "java": "[7, 6, 5, 4, 3, 2, 1]"
      }
    },
    {
      "input": "args = [[42,42,42,42]]",
      "expectedOutput": {
        "javascript": "[42,42,42,42]",
        "python": "[42, 42, 42, 42]",
        "java": "[42, 42, 42, 42]"
      }
    }
  ]
}
