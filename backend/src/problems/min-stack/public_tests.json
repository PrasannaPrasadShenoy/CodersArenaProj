{
  "tests": [
    {
      "input": "args = [[\"MinStack\",\"push\",\"push\",\"push\",\"getMin\",\"pop\",\"top\",\"getMin\"],[[],[-2],[0],[-3],[],[],[],[]]]",
      "expectedOutput": {
        "javascript": "[null,null,null,null,-3,null,0,-2]",
        "python": "[None, None, None, None, -3, None, 0, -2]",
        "java": "[null, null, null, null, -3, null, 0, -2]"
      }
    },
    {
      "input": "args = [[\"MinStack\",\"push\",\"top\",\"getMin\",\"pop\"],[[],[5],[],[],[]]]",
      "expectedOutput": {
        "javascript": "[null,null,5,5,null]",
        "python": "[None, None, 5, 5, None]",
        "java": "[null, null, 5, 5, null]"
      }
    },
    {
      "input": "args = [[\"MinStack\",\"push\",\"push\",\"push\",\"getMin\",\"pop\",\"getMin\",\"pop\",\"getMin\"],[[],[1],[1],[2],[],[],[],[],[]]]",
      "expectedOutput": {
        "javascript": "[null,null,null,null,1,null,1,null,1]",
        "python": "[None, None, None, None, 1, None, 1, None, 1]",
        "java": "[null, null, null, null, 1, null, 1, null, 1]"
      }
    }
  ],
  "combinedExpectedOutput": {
    "javascript": "[null,null,null,null,-3,null,0,-2]\n[null,null,5,5,null]\n[null,null,null,null,1,null,1,null,1]",
    "python": "[None, None, None, None, -3, None, 0, -2]\n[None, None, 5, 5, None]\n[None, None, None, None, 1, None, 1, None, 1]",
    "java": "[null, null, null, null, -3, null, 0, -2]\n[null, null, 5, 5, null]\n[null, null, null, null, 1, null, 1, null, 1]"
  }
