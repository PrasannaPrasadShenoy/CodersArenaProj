        "javascript": "\"c\"",
        "python": "\"c\"",
        "java": "\"c\""
      }
    },
    {
      "input": "args = [\"\",\"\"]",
      "expectedOutput": {
        "javascript": "\"\"",
        "python": "\"\"",
        "java": "\"\""
      }
    },
    {
      "input": "args = [\"hello\",\"\"]",
      "expectedOutput": {
        "javascript": "\"world\"",
        "python": "\"world\"",
        "java": "\"world\""
      }
    },
    {
