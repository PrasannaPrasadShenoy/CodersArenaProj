{
  "tests": [
    {
      "input": "args = [[[1,2]]]",
      "expectedOutput": {
        "javascript": "[1,2]",
        "python": "[1, 2]",
        "java": "[1, 2]"
      }
    },
    {
      "input": "args = [[[1],[2]]]",
      "expectedOutput": {
        "javascript": "[1,2]",
        "python": "[1, 2]",
        "java": "[1, 2]"
      }
    },
    {
      "input": "args = [[[1,2,3]]]",
      "expectedOutput": {
        "javascript": "[1,2,3]",
        "python": "[1, 2, 3]",
        "java": "[1, 2, 3]"
      }
    },
    {
      "input": "args = [[[1],[2],[3]]]",
      "expectedOutput": {
        "javascript": "[1,2,3]",
        "python": "[1, 2, 3]",
        "java": "[1, 2, 3]"
      }
    },
    {
      "input": "args = [[[1,2],[3,4]]]",
      "expectedOutput": {
        "javascript": "[1,2,4,3]",
        "python": "[1, 2, 4, 3]",
        "java": "[1, 2, 4, 3]"
      }
    },
    {
      "input": "args = [[[1,2,3,4,5]]]",
      "expectedOutput": {
        "javascript": "[1,2,3,4,5]",
        "python": "[1, 2, 3, 4, 5]",
        "java": "[1, 2, 3, 4, 5]"
      }
    },
    {
      "input": "args = [[[1],[2],[3],[4],[5]]]",
      "expectedOutput": {
        "javascript": "[1,2,3,4,5]",
        "python": "[1, 2, 3, 4, 5]",
        "java": "[1, 2, 3, 4, 5]"
      }
    },
    {
      "input": "args = [[[1,2,3],[4,5,6]]]",
      "expectedOutput": {
        "javascript": "[1,2,3,6,5,4]",
        "python": "[1, 2, 3, 6, 5, 4]",
        "java": "[1, 2, 3, 6, 5, 4]"
      }
    },
    {
      "input": "args = [[[1,2],[3,4],[5,6]]]",
      "expectedOutput": {
        "javascript": "[1,2,4,6,5,3]",
        "python": "[1, 2, 4, 6, 5, 3]",
        "java": "[1, 2, 4, 6, 5, 3]"
      }
    },
    {
      "input": "args = [[[7,9,6],[2,8,6],[1,3,5]]]",
      "expectedOutput": {
        "javascript": "[7,9,6,6,5,3,1,2,8]",
        "python": "[7, 9, 6, 6, 5, 3, 1, 2, 8]",
        "java": "[7, 9, 6, 6, 5, 3, 1, 2, 8]"
      }
    },
    {
      "input": "args = [[[1,2,3,4],[5,6,7,8]]]",
      "expectedOutput": {
        "javascript": "[1,2,3,4,8,7,6,5]",
        "python": "[1, 2, 3, 4, 8, 7, 6, 5]",
        "java": "[1, 2, 3, 4, 8, 7, 6, 5]"
      }
    }
  ]
}
