{
  "tests": [
    {
      "input": "args = [[]]",
      "expectedOutput": {
        "javascript": "0",
        "python": "0",
        "java": "0"
      }
    },
    {
      "input": "args = [[1]]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    },
    {
      "input": "args = [[1,2,3,4,5]]",
      "expectedOutput": {
        "javascript": "5",
        "python": "5",
        "java": "5"
      }
    },
    {
      "input": "args = [[5,4,3,2,1]]",
      "expectedOutput": {
        "javascript": "5",
        "python": "5",
        "java": "5"
      }
    },
    {
      "input": "args = [[1,3,5,7,9]]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    },
    {
      "input": "args = [[1,2,0,1]]",
      "expectedOutput": {
        "javascript": "3",
        "python": "3",
        "java": "3"
      }
    },
    {
      "input": "args = [[9,1,4,7,3,-1,0,5,8,-1,6]]",
      "expectedOutput": {
        "javascript": "7",
        "python": "7",
        "java": "7"
      }
    },
    {
      "input": "args = [[-1,-2,-3,-4,-5]]",
      "expectedOutput": {
        "javascript": "5",
        "python": "5",
        "java": "5"
      }
    },
    {
      "input": "args = [[1000000000,-1000000000]]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    },
    {
      "input": "args = [[1,2,3,5,6,7,8]]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    },
    {
      "input": "args = [[10,5,12,3,55,30,4,11,2]]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    },
    {
      "input": "args = [[1,9,3,10,4,20,2]]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    }
  ]
}
