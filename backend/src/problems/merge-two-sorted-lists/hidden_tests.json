{
  "tests": [
    {
      "input": "args = [[1],[2]]",
      "expectedOutput": {
        "javascript": "[1,2]",
        "python": "[1, 2]",
        "java": "[1, 2]"
      }
    },
    {
      "input": "args = [[2],[1]]",
      "expectedOutput": {
        "javascript": "[1,2]",
        "python": "[1, 2]",
        "java": "[1, 2]"
      }
    },
    {
      "input": "args = [[1,3,5],[2,4,6]]",
      "expectedOutput": {
        "javascript": "[1,2,3,4,5,6]",
        "python": "[1, 2, 3, 4, 5, 6]",
        "java": "[1, 2, 3, 4, 5, 6]"
      }
    },
    {
      "input": "args = [[1,1,1],[2,2,2]]",
      "expectedOutput": {
        "javascript": "[1,1,1,2,2,2]",
        "python": "[1, 1, 1, 2, 2, 2]",
        "java": "[1, 1, 1, 2, 2, 2]"
      }
    },
    {
      "input": "args = [[0],[]]",
      "expectedOutput": {
        "javascript": "[0]",
        "python": "[0]",
        "java": "[0]"
      }
    },
    {
      "input": "args = [[1,2,3],[]]",
      "expectedOutput": {
        "javascript": "[1,2,3]",
        "python": "[1, 2, 3]",
        "java": "[1, 2, 3]"
      }
    },
    {
      "input": "args = [[5],[1,2,3,4]]",
      "expectedOutput": {
        "javascript": "[1,2,3,4,5]",
        "python": "[1, 2, 3, 4, 5]",
        "java": "[1, 2, 3, 4, 5]"
      }
    },
    {
      "input": "args = [[-1,0,1],[-2,2,3]]",
      "expectedOutput": {
        "javascript": "[-2,-1,0,1,2,3]",
        "python": "[-2, -1, 0, 1, 2, 3]",
        "java": "[-2, -1, 0, 1, 2, 3]"
      }
    },
    {
      "input": "args = [[1,5,9],[2,6,8]]",
      "expectedOutput": {
        "javascript": "[1,2,5,6,8,9]",
        "python": "[1, 2, 5, 6, 8, 9]",
        "java": "[1, 2, 5, 6, 8, 9]"
      }
    },
    {
      "input": "args = [[10,20,30],[15,25,35]]",
      "expectedOutput": {
        "javascript": "[10,15,20,25,30,35]",
        "python": "[10, 15, 20, 25, 30, 35]",
        "java": "[10, 15, 20, 25, 30, 35]"
      }
    },
    {
      "input": "args = [[1,1],[1,1]]",
      "expectedOutput": {
        "javascript": "[1,1,1,1]",
        "python": "[1, 1, 1, 1]",
        "java": "[1, 1, 1, 1]"
      }
    }
  ]
}
