{
  "tests": [
    {
      "input": "args = [[1,2,4],[1,3,4]]",
      "expectedOutput": {
        "javascript": "[1,1,2,3,4,4]",
        "python": "[1, 1, 2, 3, 4, 4]",
        "java": "[1, 1, 2, 3, 4, 4]"
      }
    },
    {
      "input": "args = [[],[]]",
      "expectedOutput": {
        "javascript": "[]",
        "python": "[]",
        "java": "[]"
      }
    },
    {
      "input": "args = [[],[0]]",
      "expectedOutput": {
        "javascript": "[0]",
        "python": "[0]",
        "java": "[0]"
      }
    }
  ],
  "combinedExpectedOutput": {
    "javascript": "[1,1,2,3,4,4]\n[]\n[0]",
    "python": "[1, 1, 2, 3, 4, 4]\n[]\n[0]",
    "java": "[1, 1, 2, 3, 4, 4]\n[]\n[0]"
  }
}
