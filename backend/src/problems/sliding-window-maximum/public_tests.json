{
  "tests": [
    {
      "input": "args = [[1,3,-1,-3,5,3,6,7],3]",
      "expectedOutput": {
        "javascript": "[3,3,5,5,6,7]",
        "python": "[3, 3, 5, 5, 6, 7]",
        "java": "[3, 3, 5, 5, 6, 7]"
      }
    },
    {
      "input": "args = [[1],1]",
      "expectedOutput": {
        "javascript": "[1]",
        "python": "[1]",
        "java": "[1]"
      }
    },
    {
      "input": "args = [[1,-1],1]",
      "expectedOutput": {
        "javascript": "[1,-1]",
        "python": "[1, -1]",
        "java": "[1, -1]"
      }
    }
  ],
  "combinedExpectedOutput": {
    "javascript": "[3,3,5,5,6,7]\n[1]\n[1,-1]",
    "python": "[3, 3, 5, 5, 6, 7]\n[1]\n[1, -1]",
    "java": "[3, 3, 5, 5, 6, 7]\n[1]\n[1, -1]"
  }
}
