{
  "tests": [
    {
      "input": "args = [[[1]]]",
      "expectedOutput": {
        "javascript": "[1]",
        "python": "[1]",
        "java": "[1]"
      }
    },
    {
      "input": "args = [[[1,2],[3,4]]]",
      "expectedOutput": {
        "javascript": "[1,2,3,4]",
        "python": "[1, 2, 3, 4]",
        "java": "[1, 2, 3, 4]"
      }
    },
    {
      "input": "args = [[[5],[1,3],[2,4,6]]]",
      "expectedOutput": {
        "javascript": "[1,2,3,4,5,6]",
        "python": "[1, 2, 3, 4, 5, 6]",
        "java": "[1, 2, 3, 4, 5, 6]"
      }
    },
    {
      "input": "args = [[[-1,0,1],[-2,2]]]",
      "expectedOutput": {
        "javascript": "[-2,-1,0,1,2]",
        "python": "[-2, -1, 0, 1, 2]",
        "java": "[-2, -1, 0, 1, 2]"
      }
    },
    {
      "input": "args = [[[1,1,1],[2,2,2]]]",
      "expectedOutput": {
        "javascript": "[1,1,1,2,2,2]",
        "python": "[1, 1, 1, 2, 2, 2]",
        "java": "[1, 1, 1, 2, 2, 2]"
      }
    },
    {
      "input": "args = [[[],[1],[]]]",
      "expectedOutput": {
        "javascript": "[1]",
        "python": "[1]",
        "java": "[1]"
      }
    },
    {
      "input": "args = [[[0,0,0],[1,1,1]]]",
      "expectedOutput": {
        "javascript": "[0,0,0,1,1,1]",
        "python": "[0, 0, 0, 1, 1, 1]",
        "java": "[0, 0, 0, 1, 1, 1]"
      }
    },
    {
      "input": "args = [[[10],[5],[1]]]",
      "expectedOutput": {
        "javascript": "[1,5,10]",
        "python": "[1, 5, 10]",
        "java": "[1, 5, 10]"
      }
    },
    {
      "input": "args = [[[1,2,3,4,5]]]",
      "expectedOutput": {
        "javascript": "[1,2,3,4,5]",
        "python": "[1, 2, 3, 4, 5]",
        "java": "[1, 2, 3, 4, 5]"
      }
    },
    {
      "input": "args = [[[-10,-5],[-8,-3],[-6,-1]]]",
      "expectedOutput": {
        "javascript": "[-10,-8,-6,-5,-3,-1]",
        "python": "[-10, -8, -6, -5, -3, -1]",
        "java": "[-10, -8, -6, -5, -3, -1]"
      }
    },
    {
      "input": "args = [[[100]]]",
      "expectedOutput": {
        "javascript": "[100]",
        "python": "[100]",
        "java": "[100]"
      }
    },
    {
      "input": "args = [[[1,3,5],[2,4,6],[7,8,9]]]",
      "expectedOutput": {
        "javascript": "[1,2,3,4,5,6,7,8,9]",
        "python": "[1, 2, 3, 4, 5, 6, 7, 8, 9]",
        "java": "[1, 2, 3, 4, 5, 6, 7, 8, 9]"
      }
    }
  ]
}
