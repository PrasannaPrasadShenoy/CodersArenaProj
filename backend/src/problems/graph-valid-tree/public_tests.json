{
  "tests": [
    {
      "input": "args = [5,[[0,1],[0,2],[0,3],[1,4]]]",
      "expectedOutput": {
        "javascript": "true",
        "python": "True",
        "java": "true"
      }
    },
    {
      "input": "args = [5,[[0,1],[1,2],[2,3],[1,3],[1,4]]]",
      "expectedOutput": {
        "javascript": "false",
        "python": "False",
        "java": "false"
      }
    },
    {
      "input": "args = [1,[]]",
      "expectedOutput": {
        "javascript": "true",
        "python": "True",
        "java": "true"
      }
    }
  ],
  "combinedExpectedOutput": {
    "javascript": "true\nfalse\ntrue",
    "python": "True\nFalse\nTrue",
    "java": "true\nfalse\ntrue"
  }
}
