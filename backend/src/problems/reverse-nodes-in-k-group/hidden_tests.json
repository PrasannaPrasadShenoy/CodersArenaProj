{
  "tests": [
    {
      "input": "args = [[1,2,3,4,5],5]",
      "expectedOutput": {
        "javascript": "[5,4,3,2,1]",
        "python": "[5, 4, 3, 2, 1]",
        "java": "[5, 4, 3, 2, 1]"
      }
    },
    {
      "input": "args = [[1],1]",
      "expectedOutput": {
        "javascript": "[1]",
        "python": "[1]",
        "java": "[1]"
      }
    },
    {
      "input": "args = [[1,2],1]",
      "expectedOutput": {
        "javascript": "[1,2]",
        "python": "[1, 2]",
        "java": "[1, 2]"
      }
    },
    {
      "input": "args = [[1,2],2]",
      "expectedOutput": {
        "javascript": "[2,1]",
        "python": "[2, 1]",
        "java": "[2, 1]"
      }
    },
    {
      "input": "args = [[1,2,3],1]",
      "expectedOutput": {
        "javascript": "[1,2,3]",
        "python": "[1, 2, 3]",
        "java": "[1, 2, 3]"
      }
    },
    {
      "input": "args = [[1,2,3],2]",
      "expectedOutput": {
        "javascript": "[2,1,3]",
        "python": "[2, 1, 3]",
        "java": "[2, 1, 3]"
      }
    },
    {
      "input": "args = [[1,2,3],3]",
      "expectedOutput": {
        "javascript": "[3,2,1]",
        "python": "[3, 2, 1]",
        "java": "[3, 2, 1]"
      }
    },
    {
      "input": "args = [[1,2,3,4],2]",
      "expectedOutput": {
        "javascript": "[2,1,4,3]",
        "python": "[2, 1, 4, 3]",
        "java": "[2, 1, 4, 3]"
      }
    },
    {
      "input": "args = [[1,2,3,4],3]",
      "expectedOutput": {
        "javascript": "[3,2,1,4]",
        "python": "[3, 2, 1, 4]",
        "java": "[3, 2, 1, 4]"
      }
    },
    {
      "input": "args = [[1,2,3,4],4]",
      "expectedOutput": {
        "javascript": "[4,3,2,1]",
        "python": "[4, 3, 2, 1]",
        "java": "[4, 3, 2, 1]"
      }
    },
    {
      "input": "args = [[1,2,3,4,5,6],2]",
      "expectedOutput": {
        "javascript": "[2,1,4,3,6,5]",
        "python": "[2, 1, 4, 3, 6, 5]",
        "java": "[2, 1, 4, 3, 6, 5]"
      }
    },
    {
      "input": "args = [[1,2,3,4,5,6],3]",
      "expectedOutput": {
        "javascript": "[3,2,1,6,5,4]",
        "python": "[3, 2, 1, 6, 5, 4]",
        "java": "[3, 2, 1, 6, 5, 4]"
      }
    },
    {
      "input": "args = [[1,2,3,4,5,6],4]",
      "expectedOutput": {
        "javascript": "[4,3,2,1,5,6]",
        "python": "[4, 3, 2, 1, 5, 6]",
        "java": "[4, 3, 2, 1, 5, 6]"
      }
    },
    {
      "input": "args = [[1,2,3,4,5,6,7],2]",
      "expectedOutput": {
        "javascript": "[2,1,4,3,6,5,7]",
        "python": "[2, 1, 4, 3, 6, 5, 7]",
        "java": "[2, 1, 4, 3, 6, 5, 7]"
      }
    },
    {
      "input": "args = [[1,2,3,4,5,6,7],3]",
      "expectedOutput": {
        "javascript": "[3,2,1,6,5,4,7]",
        "python": "[3, 2, 1, 6, 5, 4, 7]",
        "java": "[3, 2, 1, 6, 5, 4, 7]"
      }
    },
    {
      "input": "args = [[1,2,3,4,5,6,7,8],2]",
      "expectedOutput": {
        "javascript": "[2,1,4,3,6,5,8,7]",
        "python": "[2, 1, 4, 3, 6, 5, 8, 7]",
        "java": "[2, 1, 4, 3, 6, 5, 8, 7]"
      }
    },
    {
      "input": "args = [[1,2,3,4,5,6,7,8],3]",
      "expectedOutput": {
        "javascript": "[3,2,1,6,5,4,7,8]",
        "python": "[3, 2, 1, 6, 5, 4, 7, 8]",
        "java": "[3, 2, 1, 6, 5, 4, 7, 8]"
      }
    }
  ]
}
