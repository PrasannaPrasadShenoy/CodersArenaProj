{
  "tests": [
    {
      "input": "args = [[[1,1],[1,1],[1,1]],2]",
      "expectedOutput": {
        "javascript": "[[1,1],[1,1]]",
        "python": "[[1, 1], [1, 1]]",
        "java": "[[1, 1], [1, 1]]"
      }
    },
    {
      "input": "args = [[[0,0]],1]",
      "expectedOutput": {
        "javascript": "[[0,0]]",
        "python": "[[0, 0]]",
        "java": "[[0, 0]]"
      }
    },
    {
      "input": "args = [[[1,0],[2,0],[3,0]],2]",
      "expectedOutput": {
        "javascript": "[[1,0],[2,0]]",
        "python": "[[1, 0], [2, 0]]",
        "java": "[[1, 0], [2, 0]]"
      }
    },
    {
      "input": "args = [[[0,3],[4,0]],1]",
      "expectedOutput": {
        "javascript": "[[0,3]]",
        "python": "[[0, 3]]",
        "java": "[[0, 3]]"
      }
    },
    {
      "input": "args = [[[-5,4],[4,6],[2,-1]],1]",
      "expectedOutput": {
        "javascript": "[[2,-1]]",
        "python": "[[2, -1]]",
        "java": "[[2, -1]]"
      }
    },
    {
      "input": "args = [[[1,1],[2,2],[3,3]],1]",
      "expectedOutput": {
        "javascript": "[[1,1]]",
        "python": "[[1, 1]]",
        "java": "[[1, 1]]"
      }
    },
    {
      "input": "args = [[[10,10],[1,1],[5,5]],2]",
      "expectedOutput": {
        "javascript": "[[1,1],[5,5]]",
        "python": "[[1, 1], [5, 5]]",
        "java": "[[1, 1], [5, 5]]"
      }
    },
    {
      "input": "args = [[[-1,-1],[1,1],[-1,1],[1,-1]],3]",
      "expectedOutput": {
        "javascript": "[[-1,1],[1,-1],[1,1]]",
        "python": "[[-1, 1], [1, -1], [1, 1]]",
        "java": "[[-1, 1], [1, -1], [1, 1]]"
      }
    },
    {
      "input": "args = [[[6,10],[-3,3],[-2,5],[0,2]],3]",
      "expectedOutput": {
        "javascript": "[[-3,3],[0,2],[-2,5]]",
        "python": "[[-3, 3], [0, 2], [-2, 5]]",
        "java": "[[-3, 3], [0, 2], [-2, 5]]"
      }
    }
  ]
}
