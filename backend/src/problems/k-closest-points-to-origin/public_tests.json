{
  "tests": [
    {
      "input": "args = [[[1,3],[-2,2]],1]",
      "expectedOutput": {
        "javascript": "[[-2,2]]",
        "python": "[[-2, 2]]",
        "java": "[[-2, 2]]"
      }
    },
    {
      "input": "args = [[[3,3],[5,-1],[-2,4]],2]",
      "expectedOutput": {
        "javascript": "[[3,3],[-2,4]]",
        "python": "[[3, 3], [-2, 4]]",
        "java": "[[3, 3], [-2, 4]]"
      }
    },
    {
      "input": "args = [[[0,1],[1,0]],2]",
      "expectedOutput": {
        "javascript": "[[0,1],[1,0]]",
        "python": "[[0, 1], [1, 0]]",
        "java": "[[0, 1], [1, 0]]"
      }
    }
  ],
  "combinedExpectedOutput": {
    "javascript": "[[-2,2]]\n[[3,3],[-2,4]]\n[[0,1],[1,0]]",
    "python": "[[-2, 2]]\n[[3, 3], [-2, 4]]\n[[0, 1], [1, 0]]",
    "java": "[[-2, 2]]\n[[3, 3], [-2, 4]]\n[[0, 1], [1, 0]]"
  }
}
