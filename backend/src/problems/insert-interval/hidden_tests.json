{
  "tests": [
    {
      "input": "args = [[[1,5]],[2,3]]",
      "expectedOutput": {
        "javascript": "[[1,5]]",
        "python": "[[1, 5]]",
        "java": "[[1, 5]]"
      }
    },
    {
      "input": "args = [[[1,5]],[6,8]]",
      "expectedOutput": {
        "javascript": "[[1,5],[6,8]]",
        "python": "[[1, 5], [6, 8]]",
        "java": "[[1, 5], [6, 8]]"
      }
    },
    {
      "input": "args = [[[1,5]],[0,0]]",
      "expectedOutput": {
        "javascript": "[[0,0],[1,5]]",
        "python": "[[0, 0], [1, 5]]",
        "java": "[[0, 0], [1, 5]]"
      }
    },
    {
      "input": "args = [[[3,5],[12,15]],[6,6]]",
      "expectedOutput": {
        "javascript": "[[3,5],[6,6],[12,15]]",
        "python": "[[3, 5], [6, 6], [12, 15]]",
        "java": "[[3, 5], [6, 6], [12, 15]]"
      }
    },
    {
      "input": "args = [[[1,2],[4,5]],[3,3]]",
      "expectedOutput": {
        "javascript": "[[1,2],[3,3],[4,5]]",
        "python": "[[1, 2], [3, 3], [4, 5]]",
        "java": "[[1, 2], [3, 3], [4, 5]]"
      }
    },
    {
      "input": "args = [[[2,5],[6,7],[8,9]],[0,1]]",
      "expectedOutput": {
        "javascript": "[[0,1],[2,5],[6,7],[8,9]]",
        "python": "[[0, 1], [2, 5], [6, 7], [8, 9]]",
        "java": "[[0, 1], [2, 5], [6, 7], [8, 9]]"
      }
    },
    {
      "input": "args = [[[1,3],[6,9]],[10,12]]",
      "expectedOutput": {
        "javascript": "[[1,3],[6,9],[10,12]]",
        "python": "[[1, 3], [6, 9], [10, 12]]",
        "java": "[[1, 3], [6, 9], [10, 12]]"
      }
    },
    {
      "input": "args = [[[1,4],[5,6]],[2,3]]",
      "expectedOutput": {
        "javascript": "[[1,4],[5,6]]",
        "python": "[[1, 4], [5, 6]]",
        "java": "[[1, 4], [5, 6]]"
      }
    },
    {
      "input": "args = [[[1,2],[3,4],[5,6]],[0,7]]",
      "expectedOutput": {
        "javascript": "[[0,7]]",
        "python": "[[0, 7]]",
        "java": "[[0, 7]]"
      }
    },
    {
      "input": "args = [[[2,3],[5,6]],[1,4]]",
      "expectedOutput": {
        "javascript": "[[1,4],[5,6]]",
        "python": "[[1, 4], [5, 6]]",
        "java": "[[1, 4], [5, 6]]"
      }
    },
    {
      "input": "args = [[[1,5],[10,15]],[6,9]]",
      "expectedOutput": {
        "javascript": "[[1,5],[6,9],[10,15]]",
        "python": "[[1, 5], [6, 9], [10, 15]]",
        "java": "[[1, 5], [6, 9], [10, 15]]"
      }
    }
  ]
}
