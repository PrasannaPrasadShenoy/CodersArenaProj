{
  "tests": [
    {
      "input": "args = [[[1,3],[6,9]],[2,5]]",
      "expectedOutput": {
        "javascript": "[[1,5],[6,9]]",
        "python": "[[1, 5], [6, 9]]",
        "java": "[[1, 5], [6, 9]]"
      }
    },
    {
      "input": "args = [[[1,2],[3,5],[6,7],[8,10],[12,16]],[4,8]]",
      "expectedOutput": {
        "javascript": "[[1,2],[3,10],[12,16]]",
        "python": "[[1, 2], [3, 10], [12, 16]]",
        "java": "[[1, 2], [3, 10], [12, 16]]"
      }
    },
    {
      "input": "args = [[],[5,7]]",
      "expectedOutput": {
        "javascript": "[[5,7]]",
        "python": "[[5, 7]]",
        "java": "[[5, 7]]"
      }
    }
  ],
  "combinedExpectedOutput": {
    "javascript": "[[1,5],[6,9]]\n[[1,2],[3,10],[12,16]]\n[[5,7]]",
    "python": "[[1, 5], [6, 9]]\n[[1, 2], [3, 10], [12, 16]]\n[[5, 7]]",
    "java": "[[1, 5], [6, 9]]\n[[1, 2], [3, 10], [12, 16]]\n[[5, 7]]"
  }
}
