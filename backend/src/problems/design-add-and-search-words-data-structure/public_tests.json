{
  "tests": [
    {
      "input": "args = [[\"WordDictionary\",\"addWord\",\"addWord\",\"addWord\",\"search\",\"search\",\"search\",\"search\"],[[],[\"bad\"],[\"dad\"],[\"mad\"],[\"pad\"],[\"bad\"],[\".ad\"],[\"b..\"]]]",
      "expectedOutput": {
        "javascript": "[null,null,null,null,false,true,true,true]",
        "python": "[None, None, None, None, False, True, True, True]",
        "java": "[null, null, null, null, false, true, true, true]"
      }
    },
    {
      "input": "args = [[\"WordDictionary\",\"addWord\",\"search\",\"search\",\"search\"],[[],[\"a\"],[\"a\"],[\".\"],[\"aa\"]]]",
