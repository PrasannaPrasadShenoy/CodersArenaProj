{
  "tests": [
    {
      "input": "args = [[\"3\"]]",
      "expectedOutput": {
        "javascript": "3",
        "python": "3",
        "java": "3"
      }
    },
    {
      "input": "args = [[\"15\",\"7\",\"1\",\"1\",\"+\",\"-\",\"/\",\"3\",\"*\",\"2\",\"1\",\"1\",\"+\",\"+\",\"-\"]]",
      "expectedOutput": {
        "javascript": "5",
        "python": "5",
        "java": "5"
      }
    },
    {
      "input": "args = [[\"2\",\"1\",\"+\"]]",
      "expectedOutput": {
        "javascript": "3",
        "python": "3",
        "java": "3"
      }
    },
    {
      "input": "args = [[\"2\",\"1\",\"-\"]]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    },
    {
      "input": "args = [[\"3\",\"4\",\"*\"]]",
      "expectedOutput": {
        "javascript": "12",
        "python": "12",
        "java": "12"
      }
    },
    {
      "input": "args = [[\"8\",\"2\",\"/\"]]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    },
    {
      "input": "args = [[\"5\",\"1\",\"2\",\"+\",\"4\",\"*\",\"+\",\"3\",\"-\"]]",
      "expectedOutput": {
        "javascript": "14",
        "python": "14",
        "java": "14"
      }
    },
    {
      "input": "args = [[\"-1\",\"2\",\"+\"]]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    },
    {
      "input": "args = [[\"0\",\"3\",\"/\"]]",
      "expectedOutput": {
        "javascript": "0",
        "python": "0",
        "java": "0"
      }
    },
    {
      "input": "args = [[\"18\",\"6\",\"/\",\"3\",\"/\"]]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    }
  ]
}
