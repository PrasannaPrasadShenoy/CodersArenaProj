{
  "tests": [
    {
      "input": "args = [3,[[1,0],[2,1]]]",
      "expectedOutput": {
        "javascript": "true",
        "python": "True",
        "java": "true"
      }
    },
    {
      "input": "args = [4,[[1,0],[2,1],[3,2],[1,3]]]",
      "expectedOutput": {
        "javascript": "false",
        "python": "False",
        "java": "false"
      }
    },
    {
      "input": "args = [3,[[0,1],[0,2],[1,2]]]",
      "expectedOutput": {
        "javascript": "true",
        "python": "True",
        "java": "true"
      }
    },
    {
      "input": "args = [4,[[0,1],[1,2],[2,3],[3,1]]]",
      "expectedOutput": {
        "javascript": "false",
        "python": "False",
        "java": "false"
      }
    },
    {
      "input": "args = [6,[[0,1],[1,2],[2,3],[3,4],[4,5]]]",
      "expectedOutput": {
        "javascript": "true",
        "python": "True",
        "java": "true"
      }
    },
    {
      "input": "args = [3,[[1,0],[2,0]]]",
      "expectedOutput": {
        "javascript": "true",
        "python": "True",
        "java": "true"
      }
    },
    {
      "input": "args = [5,[[0,1],[1,2],[2,3],[3,4],[4,0]]]",
      "expectedOutput": {
        "javascript": "false",
        "python": "False",
        "java": "false"
      }
    },
    {
      "input": "args = [4,[[1,0],[2,0],[3,1],[3,2]]]",
      "expectedOutput": {
        "javascript": "true",
        "python": "True",
        "java": "true"
      }
    },
    {
      "input": "args = [5,[[1,0],[2,1],[3,2],[4,3],[0,4]]]",
      "expectedOutput": {
        "javascript": "false",
        "python": "False",
        "java": "false"
      }
    }
  ]
