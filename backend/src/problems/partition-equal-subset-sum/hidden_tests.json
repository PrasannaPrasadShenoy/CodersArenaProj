{
  "tests": [
    {
      "input": "args = [[1]]",
      "expectedOutput": {
        "javascript": "false",
        "python": "False",
        "java": "false"
      }
    },
    {
      "input": "args = [[2,2,1,1]]",
      "expectedOutput": {
        "javascript": "true",
        "python": "True",
        "java": "true"
      }
    },
    {
      "input": "args = [[100]]",
      "expectedOutput": {
        "javascript": "false",
        "python": "False",
        "java": "false"
      }
    },
    {
      "input": "args = [[1,2,5]]",
      "expectedOutput": {
        "javascript": "false",
        "python": "False",
        "java": "false"
      }
    },
    {
      "input": "args = [[1,3,5,7]]",
      "expectedOutput": {
        "javascript": "true",
        "python": "True",
        "java": "true"
      }
    },
    {
      "input": "args = [[2,2,3,5]]",
      "expectedOutput": {
        "javascript": "false",
        "python": "False",
        "java": "false"
      }
    },
    {
      "input": "args = [[1,2,3,4,5,6,7]]",
      "expectedOutput": {
        "javascript": "true",
        "python": "True",
        "java": "true"
      }
    },
    {
      "input": "args = [[3,3,3,4,5]]",
      "expectedOutput": {
        "javascript": "true",
        "python": "True",
        "java": "true"
      }
    },
    {
      "input": "args = [[1,1,1,1]]",
      "expectedOutput": {
        "javascript": "true",
        "python": "True",
        "java": "true"
      }
    },
    {
      "input": "args = [[23,13,11,7,6,5,5]]",
      "expectedOutput": {
        "javascript": "true",
        "python": "True",
        "java": "true"
      }
    },
    {
      "input": "args = [[1,5,3]]",
      "expectedOutput": {
        "javascript": "false",
        "python": "False",
        "java": "false"
      }
    },
    {
      "input": "args = [[4,4,4,4,4,4]]",
      "expectedOutput": {
        "javascript": "true",
        "python": "True",
        "java": "true"
      }
    }
  ]
}
