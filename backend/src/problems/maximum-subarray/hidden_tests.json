{
  "tests": [
    {
      "input": "args = [[-1]]",
      "expectedOutput": {
        "javascript": "-1",
        "python": "-1",
        "java": "-1"
      }
    },
    {
      "input": "args = [[-2,-1]]",
      "expectedOutput": {
        "javascript": "-1",
        "python": "-1",
        "java": "-1"
      }
    },
    {
      "input": "args = [[1,2,3,4,5]]",
      "expectedOutput": {
        "javascript": "15",
        "python": "15",
        "java": "15"
      }
    },
    {
      "input": "args = [[-5,-2,-8,-1]]",
      "expectedOutput": {
        "javascript": "-1",
        "python": "-1",
        "java": "-1"
      }
    },
    {
      "input": "args = [[0]]",
      "expectedOutput": {
        "javascript": "0",
        "python": "0",
        "java": "0"
      }
    },
    {
      "input": "args = [[0,-1,0]]",
      "expectedOutput": {
        "javascript": "0",
        "python": "0",
        "java": "0"
      }
    },
    {
      "input": "args = [[-3,-2,-1,-5]]",
      "expectedOutput": {
        "javascript": "-1",
        "python": "-1",
        "java": "-1"
      }
    },
    {
      "input": "args = [[2,-1,2,-1,2]]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    },
    {
      "input": "args = [[1,-3,2,1,-1]]",
      "expectedOutput": {
        "javascript": "3",
        "python": "3",
        "java": "3"
      }
    },
    {
      "input": "args = [[-2,-3,4,-1,-2,1,5,-3]]",
      "expectedOutput": {
        "javascript": "7",
        "python": "7",
        "java": "7"
      }
    },
    {
      "input": "args = [[10,-5,3,-2,8]]",
      "expectedOutput": {
        "javascript": "14",
        "python": "14",
        "java": "14"
      }
    },
    {
      "input": "args = [[100]]",
      "expectedOutput": {
        "javascript": "100",
        "python": "100",
        "java": "100"
      }
    }
  ]
}
