        "python": "False",
        "java": "false"
      }
    }
  ],
  "combinedExpectedOutput": {
    "javascript": "true\ntrue\nfalse",
    "python": "True\nTrue\nFalse",
    "java": "true\ntrue\nfalse"
  }
}
