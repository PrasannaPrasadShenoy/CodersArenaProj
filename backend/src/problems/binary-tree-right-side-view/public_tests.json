{
  "tests": [
    {
      "input": "args = [[1,2,3,null,5,null,4]]",
      "expectedOutput": {
        "javascript": "[1,3,4]",
        "python": "[1, 3, 4]",
        "java": "[1, 3, 4]"
      }
    },
    {
      "input": "args = [[1,2,3,4,null,null,null,5]]",
      "expectedOutput": {
        "javascript": "[1,3,4,5]",
        "python": "[1, 3, 4, 5]",
        "java": "[1, 3, 4, 5]"
      }
    },
    {
      "input": "args = [[1,null,3]]",
      "expectedOutput": {
        "javascript": "[1,3]",
        "python": "[1, 3]",
        "java": "[1, 3]"
      }
    }
  ],
  "combinedExpectedOutput": {
    "javascript": "[1,3,4]\n[1,3,4,5]\n[1,3]",
    "python": "[1, 3, 4]\n[1, 3, 4, 5]\n[1, 3]",
    "java": "[1, 3, 4]\n[1, 3, 4, 5]\n[1, 3]"
  }
}
