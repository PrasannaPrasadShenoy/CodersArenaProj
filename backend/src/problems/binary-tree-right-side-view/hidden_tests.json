{
  "tests": [
    {
      "input": "args = [[]]",
      "expectedOutput": {
        "javascript": "[]",
        "python": "[]",
        "java": "[]"
      }
    },
    {
      "input": "args = [[1]]",
      "expectedOutput": {
        "javascript": "[1]",
        "python": "[1]",
        "java": "[1]"
      }
    },
    {
      "input": "args = [[1,2]]",
      "expectedOutput": {
        "javascript": "[1,2]",
        "python": "[1, 2]",
        "java": "[1, 2]"
      }
    },
    {
      "input": "args = [[1,null,2]]",
      "expectedOutput": {
        "javascript": "[1,2]",
        "python": "[1, 2]",
        "java": "[1, 2]"
      }
    },
    {
      "input": "args = [[1,2,3]]",
      "expectedOutput": {
        "javascript": "[1,3]",
        "python": "[1, 3]",
        "java": "[1, 3]"
      }
    },
    {
      "input": "args = [[1,2,null,4]]",
      "expectedOutput": {
        "javascript": "[1,2,4]",
        "python": "[1, 2, 4]",
        "java": "[1, 2, 4]"
      }
    },
    {
      "input": "args = [[1,2,3,4,5,6,7]]",
      "expectedOutput": {
        "javascript": "[1,3,7]",
        "python": "[1, 3, 7]",
        "java": "[1, 3, 7]"
      }
    },
    {
      "input": "args = [[1,2,3,null,null,4,5]]",
      "expectedOutput": {
        "javascript": "[1,3,5]",
        "python": "[1, 3, 5]",
        "java": "[1, 3, 5]"
      }
    },
    {
      "input": "args = [[5,4,6,null,null,null,7]]",
      "expectedOutput": {
        "javascript": "[5,6,7]",
        "python": "[5, 6, 7]",
        "java": "[5, 6, 7]"
      }
    },
    {
      "input": "args = [[1,2,3,4,5,null,null,8]]",
      "expectedOutput": {
        "javascript": "[1,3,5,8]",
        "python": "[1, 3, 5, 8]",
        "java": "[1, 3, 5, 8]"
      }
    },
    {
      "input": "args = [[10,5,15,null,6,12,20]]",
      "expectedOutput": {
        "javascript": "[10,15,20]",
        "python": "[10, 15, 20]",
        "java": "[10, 15, 20]"
      }
    }
  ]
}
