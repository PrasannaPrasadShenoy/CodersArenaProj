{
  "tests": [
    {
      "input": "args = [[5],-5]",
      "expectedOutput": {
        "javascript": "-1",
        "python": "-1",
        "java": "-1"
      }
    },
    {
      "input": "args = [[1,3,5,7,9],1]",
      "expectedOutput": {
        "javascript": "0",
        "python": "0",
        "java": "0"
      }
    },
    {
      "input": "args = [[1,3,5,7,9],9]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    },
    {
      "input": "args = [[1,3,5,7,9],4]",
      "expectedOutput": {
        "javascript": "-1",
        "python": "-1",
        "java": "-1"
      }
    },
    {
      "input": "args = [[1,3],1]",
      "expectedOutput": {
        "javascript": "0",
        "python": "0",
        "java": "0"
      }
    },
    {
      "input": "args = [[1,3],3]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    },
    {
      "input": "args = [[1,3],2]",
      "expectedOutput": {
        "javascript": "-1",
        "python": "-1",
        "java": "-1"
      }
    },
    {
      "input": "args = [[-5,-2,0,3,7],-2]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    },
    {
      "input": "args = [[-5,-2,0,3,7],0]",
      "expectedOutput": {
        "javascript": "2",
        "python": "2",
        "java": "2"
      }
    },
    {
      "input": "args = [[-5,-2,0,3,7],-1]",
      "expectedOutput": {
        "javascript": "-1",
        "python": "-1",
        "java": "-1"
      }
    }
  ]
}
