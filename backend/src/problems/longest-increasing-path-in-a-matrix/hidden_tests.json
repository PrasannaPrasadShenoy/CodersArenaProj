{
  "tests": [
    {
      "input": "args = [[[1,2]]]",
      "expectedOutput": {
        "javascript": "2",
        "python": "2",
        "java": "2"
      }
    },
    {
      "input": "args = [[[2,1]]]",
      "expectedOutput": {
        "javascript": "2",
        "python": "2",
        "java": "2"
      }
    },
    {
      "input": "args = [[[1],[2]]]",
      "expectedOutput": {
        "javascript": "2",
        "python": "2",
        "java": "2"
      }
    },
    {
      "input": "args = [[[1],[1],[1]]]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    },
    {
      "input": "args = [[[1,2,3]]]",
      "expectedOutput": {
        "javascript": "3",
        "python": "3",
        "java": "3"
      }
    },
    {
      "input": "args = [[[3,2,1]]]",
      "expectedOutput": {
        "javascript": "3",
        "python": "3",
        "java": "3"
      }
    },
    {
      "input": "args = [[[1,2,3],[6,5,4],[7,8,9]]]",
      "expectedOutput": {
        "javascript": "9",
        "python": "9",
        "java": "9"
      }
    },
    {
      "input": "args = [[[9,8,7],[2,1,6],[3,4,5]]]",
      "expectedOutput": {
        "javascript": "9",
        "python": "9",
        "java": "9"
      }
    },
    {
      "input": "args = [[[1,2,3],[4,5,6],[7,8,9]]]",
      "expectedOutput": {
        "javascript": "5",
        "python": "5",
        "java": "5"
      }
    },
    {
      "input": "args = [[[9,8,7],[6,5,4],[3,2,1]]]",
      "expectedOutput": {
        "javascript": "5",
        "python": "5",
        "java": "5"
      }
    },
    {
      "input": "args = [[[3,4,5],[3,2,6],[2,2,7]]]",
      "expectedOutput": {
        "javascript": "5",
        "python": "5",
        "java": "5"
      }
    }
  ]
}
