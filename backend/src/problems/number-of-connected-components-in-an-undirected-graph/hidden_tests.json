{
  "tests": [
    {
      "input": "args = [2,[[0,1]]]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    },
    {
      "input": "args = [2,[]]",
      "expectedOutput": {
        "javascript": "2",
        "python": "2",
        "java": "2"
      }
    },
    {
      "input": "args = [3,[[0,1]]]",
      "expectedOutput": {
        "javascript": "2",
        "python": "2",
        "java": "2"
      }
    },
    {
      "input": "args = [3,[[0,1],[1,2]]]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    },
    {
      "input": "args = [4,[[0,1],[2,3]]]",
      "expectedOutput": {
        "javascript": "2",
        "python": "2",
        "java": "2"
      }
    },
    {
      "input": "args = [4,[[0,1],[1,2],[2,3]]]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    },
    {
      "input": "args = [6,[[0,1],[1,2],[3,4]]]",
      "expectedOutput": {
        "javascript": "3",
        "python": "3",
        "java": "3"
      }
    },
    {
      "input": "args = [0,[]]",
      "expectedOutput": {
        "javascript": "0",
        "python": "0",
        "java": "0"
      }
    },
    {
      "input": "args = [7,[[0,1],[1,2],[3,4],[4,5]]]",
      "expectedOutput": {
        "javascript": "3",
        "python": "3",
        "java": "3"
      }
    },
    {
      "input": "args = [8,[[0,1],[1,2],[2,3],[4,5],[5,6],[6,7]]]",
      "expectedOutput": {
        "javascript": "2",
        "python": "2",
        "java": "2"
      }
    },
    {
      "input": "args = [5,[[0,1],[0,2],[0,3],[0,4]]]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    },
    {
      "input": "args = [6,[[0,1],[0,2],[1,3],[2,4],[3,5]]]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    },
    {
      "input": "args = [10,[]]",
      "expectedOutput": {
        "javascript": "10",
        "python": "10",
        "java": "10"
      }
    },
    {
      "input": "args = [4,[[0,1],[0,2],[1,2]]]",
      "expectedOutput": {
        "javascript": "2",
        "python": "2",
        "java": "2"
      }
    },
    {
      "input": "args = [5,[[0,1],[2,3],[4,4]]]",
      "expectedOutput": {
        "javascript": "3",
        "python": "3",
        "java": "3"
      }
    }
  ]
}
