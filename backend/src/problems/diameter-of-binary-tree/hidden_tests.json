{
  "tests": [
    {
      "input": "args = [[1]]",
      "expectedOutput": {
        "javascript": "0",
        "python": "0",
        "java": "0"
      }
    },
    {
      "input": "args = [[1,2,3]]",
      "expectedOutput": {
        "javascript": "2",
        "python": "2",
        "java": "2"
      }
    },
    {
      "input": "args = [[1,null,2]]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    },
    {
      "input": "args = [[1,2,3,4,5,null,null,6,7]]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    },
    {
      "input": "args = [[4,2,6,1,3,5,7]]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    },
    {
      "input": "args = [[1,2,null,3,null,4]]",
      "expectedOutput": {
        "javascript": "3",
        "python": "3",
        "java": "3"
      }
    },
    {
      "input": "args = [[1,2,3,null,null,4,5,null,null,6,7]]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    },
    {
      "input": "args = [[10,5,15,3,7,12,20]]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    },
    {
      "input": "args = [[1,null,2,null,3,null,4]]",
      "expectedOutput": {
        "javascript": "3",
        "python": "3",
        "java": "3"
      }
    }
  ]
}
