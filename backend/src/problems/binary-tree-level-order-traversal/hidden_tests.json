{
  "tests": [
    {
      "input": "args = [[1,2,3,4,5,6,7]]",
      "expectedOutput": {
        "javascript": "[[1],[2,3],[4,5,6,7]]",
        "python": "[[1], [2, 3], [4, 5, 6, 7]]",
        "java": "[[1], [2, 3], [4, 5, 6, 7]]"
      }
    },
    {
      "input": "args = [[1,2,null,3,null,4,null,5]]",
      "expectedOutput": {
        "javascript": "[[1],[2],[3],[4],[5]]",
        "python": "[[1], [2], [3], [4], [5]]",
        "java": "[[1], [2], [3], [4], [5]]"
      }
    },
    {
      "input": "args = [[1,null,2,null,3]]",
      "expectedOutput": {
        "javascript": "[[1],[2],[3]]",
        "python": "[[1], [2], [3]]",
        "java": "[[1], [2], [3]]"
      }
    },
    {
      "input": "args = [[1,2,null,3,null]]",
      "expectedOutput": {
        "javascript": "[[1],[2],[3]]",
        "python": "[[1], [2], [3]]",
        "java": "[[1], [2], [3]]"
      }
    },
    {
      "input": "args = [[0]]",
      "expectedOutput": {
        "javascript": "[[0]]",
        "python": "[[0]]",
        "java": "[[0]]"
      }
    },
    {
      "input": "args = [[-1,-2,-3]]",
      "expectedOutput": {
        "javascript": "[[-1],[-2,-3]]",
        "python": "[[-1], [-2, -3]]",
        "java": "[[-1], [-2, -3]]"
      }
    },
    {
      "input": "args = [[1,2,3,null,null,null,4]]",
      "expectedOutput": {
        "javascript": "[[1],[2,3],[4]]",
        "python": "[[1], [2, 3], [4]]",
        "java": "[[1], [2, 3], [4]]"
      }
    },
    {
      "input": "args = [[5,4,8,11,null,13,4,7,2,null,null,null,1]]",
      "expectedOutput": {
        "javascript": "[[5],[4,8],[11,13,4],[7,2,1]]",
        "python": "[[5], [4, 8], [11, 13, 4], [7, 2, 1]]",
        "java": "[[5], [4, 8], [11, 13, 4], [7, 2, 1]]"
      }
    },
    {
      "input": "args = [[1,2,2,3,3,3,3]]",
      "expectedOutput": {
        "javascript": "[[1],[2,2],[3,3,3,3]]",
        "python": "[[1], [2, 2], [3, 3, 3, 3]]",
        "java": "[[1], [2, 2], [3, 3, 3, 3]]"
      }
    },
    {
      "input": "args = [[1,null,null]]",
      "expectedOutput": {
        "javascript": "[[1]]",
        "python": "[[1]]",
        "java": "[[1]]"
      }
    }
  ]
}
