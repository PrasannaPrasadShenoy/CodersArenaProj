{
  "tests": [
    {
      "input": "args = [[1]]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    },
    {
      "input": "args = [[1,2]]",
      "expectedOutput": {
        "javascript": "2",
        "python": "2",
        "java": "2"
      }
    },
    {
      "input": "args = [[1,2,3]]",
      "expectedOutput": {
        "javascript": "2",
        "python": "2",
        "java": "2"
      }
    },
    {
      "input": "args = [[1,2,3,4]]",
      "expectedOutput": {
        "javascript": "3",
        "python": "3",
        "java": "3"
      }
    },
    {
      "input": "args = [[1,null,2,null,3]]",
      "expectedOutput": {
        "javascript": "3",
        "python": "3",
        "java": "3"
      }
    },
    {
      "input": "args = [[1,2,3,4,5,6,7]]",
      "expectedOutput": {
        "javascript": "3",
        "python": "3",
        "java": "3"
      }
    },
    {
      "input": "args = [[1,2,null,4,null,null,null,8]]",
      "expectedOutput": {
        "javascript": "3",
        "python": "3",
        "java": "3"
      }
    },
    {
      "input": "args = [[5,4,8,11,null,13,4,7,2,null,null,null,1]]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    },
    {
      "input": "args = [[1,2,3,null,null,4,5,null,null,6]]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    },
    {
      "input": "args = [[10]]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    },
    {
      "input": "args = [[1,2,2,3,3,3,3]]",
      "expectedOutput": {
        "javascript": "3",
        "python": "3",
        "java": "3"
      }
    },
    {
      "input": "args = [[0,-1,1,-2,-1,0,2]]",
      "expectedOutput": {
        "javascript": "3",
        "python": "3",
        "java": "3"
      }
    }
  ]
}
