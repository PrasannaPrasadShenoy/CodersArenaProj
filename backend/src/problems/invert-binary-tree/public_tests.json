{
  "tests": [
    {
      "input": "args = [[4,2,7,1,3,6,9]]",
      "expectedOutput": {
        "javascript": "[4,7,2,9,6,3,1]",
        "python": "[4, 7, 2, 9, 6, 3, 1]",
        "java": "[4, 7, 2, 9, 6, 3, 1]"
      }
    },
    {
      "input": "args = [[2,1,3]]",
      "expectedOutput": {
        "javascript": "[2,3,1]",
        "python": "[2, 3, 1]",
        "java": "[2, 3, 1]"
      }
    },
    {
      "input": "args = [[]]",
      "expectedOutput": {
        "javascript": "[]",
        "python": "[]",
        "java": "[]"
      }
    }
  ],
  "combinedExpectedOutput": {
    "javascript": "[4,7,2,9,6,3,1]\n[2,3,1]\n[]",
    "python": "[4, 7, 2, 9, 6, 3, 1]\n[2, 3, 1]\n[]",
    "java": "[4, 7, 2, 9, 6, 3, 1]\n[2, 3, 1]\n[]"
  }
}
