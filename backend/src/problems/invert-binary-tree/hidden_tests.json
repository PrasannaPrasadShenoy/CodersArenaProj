{
  "tests": [
    {
      "input": "args = [[1]]",
      "expectedOutput": {
        "javascript": "[1]",
        "python": "[1]",
        "java": "[1]"
      }
    },
    {
      "input": "args = [[1,2]]",
      "expectedOutput": {
        "javascript": "[1,null,2]",
        "python": "[1, None, 2]",
        "java": "[1, null, 2]"
      }
    },
    {
      "input": "args = [[1,null,2]]",
      "expectedOutput": {
        "javascript": "[1,2]",
        "python": "[1, 2]",
        "java": "[1, 2]"
      }
    },
    {
      "input": "args = [[1,2,3,4,5]]",
      "expectedOutput": {
        "javascript": "[1,3,2,null,null,5,4]",
        "python": "[1, 3, 2, None, None, 5, 4]",
        "java": "[1, 3, 2, null, null, 5, 4]"
      }
    },
    {
      "input": "args = [[1,2,3,null,null,4,5]]",
      "expectedOutput": {
        "javascript": "[1,3,2,5,4]",
        "python": "[1, 3, 2, 5, 4]",
        "java": "[1, 3, 2, 5, 4]"
      }
    },
    {
      "input": "args = [[1,2,3,4,5,6,7]]",
      "expectedOutput": {
        "javascript": "[1,3,2,7,6,5,4]",
        "python": "[1, 3, 2, 7, 6, 5, 4]",
        "java": "[1, 3, 2, 7, 6, 5, 4]"
      }
    },
    {
      "input": "args = [[5,3,8,2,4,7,9]]",
      "expectedOutput": {
        "javascript": "[5,8,3,9,7,4,2]",
        "python": "[5, 8, 3, 9, 7, 4, 2]",
        "java": "[5, 8, 3, 9, 7, 4, 2]"
      }
    },
    {
      "input": "args = [[10,5,15,null,6,12,20]]",
      "expectedOutput": {
        "javascript": "[10,15,5,20,12,6]",
        "python": "[10, 15, 5, 20, 12, 6]",
        "java": "[10, 15, 5, 20, 12, 6]"
      }
    },
    {
      "input": "args = [[1,2,null,3]]",
      "expectedOutput": {
        "javascript": "[1,null,2,null,3]",
        "python": "[1, None, 2, None, 3]",
        "java": "[1, null, 2, null, 3]"
      }
    },
    {
      "input": "args = [[0,-1,1]]",
      "expectedOutput": {
        "javascript": "[0,1,-1]",
        "python": "[0, 1, -1]",
        "java": "[0, 1, -1]"
      }
    },
    {
      "input": "args = [[100,50,150]]",
      "expectedOutput": {
        "javascript": "[100,150,50]",
        "python": "[100, 150, 50]",
        "java": "[100, 150, 50]"
      }
    },
    {
      "input": "args = [[1,2,3,null,4,null,5]]",
      "expectedOutput": {
        "javascript": "[1,3,2,5,null,4]",
        "python": "[1, 3, 2, 5, None, 4]",
        "java": "[1, 3, 2, 5, null, 4]"
      }
    }
  ]
}
