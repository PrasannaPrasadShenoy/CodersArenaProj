{
  "tests": [
    {
      "input": "args = [[1,2,3,4,5],2]",
      "expectedOutput": {
        "javascript": "[1,2,3,5]",
        "python": "[1, 2, 3, 5]",
        "java": "[1, 2, 3, 5]"
      }
    },
    {
      "input": "args = [[1],1]",
      "expectedOutput": {
        "javascript": "[]",
        "python": "[]",
        "java": "[]"
      }
    },
    {
      "input": "args = [[1,2],1]",
      "expectedOutput": {
        "javascript": "[1]",
        "python": "[1]",
        "java": "[1]"
      }
    }
  ],
  "combinedExpectedOutput": {
    "javascript": "[1,2,3,5]\n[]\n[1]",
    "python": "[1, 2, 3, 5]\n[]\n[1]",
    "java": "[1, 2, 3, 5]\n[]\n[1]"
  }
}
