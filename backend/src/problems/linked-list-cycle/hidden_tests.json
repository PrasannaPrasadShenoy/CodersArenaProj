      "expectedOutput": {
        "javascript": "true",
        "python": "True",
        "java": "true"
      }
    },
    {
      "input": "args = [[1,2,3,4,5],4]",
      "expectedOutput": {
        "javascript": "true",
        "python": "True",
        "java": "true"
      }
    },
    {
      "input": "args = [[1],0]",
      "expectedOutput": {
        "javascript": "true",
        "python": "True",
        "java": "true"
      }
    },
    {
      "input": "args = [[1,2],1]",
      "expectedOutput": {
        "javascript": "true",
        "python": "True",
        "java": "true"
      }
    },
    {
