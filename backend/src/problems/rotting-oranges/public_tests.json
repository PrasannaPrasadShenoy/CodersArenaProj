{
  "tests": [
    {
      "input": "args = [[[2,1,1],[1,1,0],[0,1,1]]]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    },
    {
      "input": "args = [[[2,1,1],[0,1,1],[1,0,1]]]",
      "expectedOutput": {
        "javascript": "-1",
        "python": "-1",
        "java": "-1"
      }
    },
    {
      "input": "args = [[[0,2]]]",
      "expectedOutput": {
        "javascript": "0",
        "python": "0",
        "java": "0"
      }
    }
  ],
  "combinedExpectedOutput": {
    "javascript": "4\n-1\n0",
    "python": "4\n-1\n0",
    "java": "4\n-1\n0"
  }
}
