{
  "tests": [
    {
      "input": "args = [[5],[4]]",
      "expectedOutput": {
        "javascript": "0",
        "python": "0",
        "java": "0"
      }
    },
    {
      "input": "args = [[2],[2]]",
      "expectedOutput": {
        "javascript": "0",
        "python": "0",
        "java": "0"
      }
    },
    {
      "input": "args = [[1,2,3],[3,3,3]]",
      "expectedOutput": {
        "javascript": "-1",
        "python": "-1",
        "java": "-1"
      }
    },
    {
      "input": "args = [[3,1,1],[1,2,2]]",
      "expectedOutput": {
        "javascript": "0",
        "python": "0",
        "java": "0"
      }
    },
    {
      "input": "args = [[5,1,2,3,4],[4,4,1,5,1]]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    },
    {
      "input": "args = [[1,2,3,4,5,5,70],[2,3,4,3,9,6,2]]",
      "expectedOutput": {
        "javascript": "6",
        "python": "6",
        "java": "6"
      }
    },
    {
      "input": "args = [[4,5,2,6,5,3],[3,2,7,3,2,9]]",
      "expectedOutput": {
        "javascript": "-1",
        "python": "-1",
        "java": "-1"
      }
    },
    {
      "input": "args = [[6,1,4,3,5],[3,8,2,4,2]]",
      "expectedOutput": {
        "javascript": "2",
        "python": "2",
        "java": "2"
      }
    },
    {
      "input": "args = [[2,3,4,5],[3,4,5,6]]",
      "expectedOutput": {
        "javascript": "-1",
        "python": "-1",
        "java": "-1"
      }
    }
  ]
}
