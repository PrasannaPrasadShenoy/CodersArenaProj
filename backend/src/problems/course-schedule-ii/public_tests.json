{
  "tests": [
    {
      "input": "args = [2,[[1,0]]]",
      "expectedOutput": {
        "javascript": "[0,1]",
        "python": "[0, 1]",
        "java": "[0, 1]"
      }
    },
    {
      "input": "args = [4,[[1,0],[2,0],[3,1],[3,2]]]",
      "expectedOutput": {
        "javascript": "[0,2,1,3]",
        "python": "[0, 2, 1, 3]",
        "java": "[0, 2, 1, 3]"
      }
    },
    {
      "input": "args = [1,[]]",
      "expectedOutput": {
        "javascript": "[0]",
        "python": "[0]",
        "java": "[0]"
      }
    }
  ],
  "combinedExpectedOutput": {
    "javascript": "[0,1]\n[0,2,1,3]\n[0]",
    "python": "[0, 1]\n[0, 2, 1, 3]\n[0]",
    "java": "[0, 1]\n[0, 2, 1, 3]\n[0]"
  }
}
