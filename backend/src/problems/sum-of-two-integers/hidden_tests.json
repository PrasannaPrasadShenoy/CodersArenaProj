{
  "tests": [
    {
      "input": "args = [0,0]",
      "expectedOutput": {
        "javascript": "0",
        "python": "0",
        "java": "0"
      }
    },
    {
      "input": "args = [100,200]",
      "expectedOutput": {
        "javascript": "300",
        "python": "300",
        "java": "300"
      }
    },
    {
      "input": "args = [-100,-200]",
      "expectedOutput": {
        "javascript": "-300",
        "python": "-300",
        "java": "-300"
      }
    },
    {
      "input": "args = [1,-1]",
      "expectedOutput": {
        "javascript": "0",
        "python": "0",
        "java": "0"
      }
    },
    {
      "input": "args = [999,1]",
      "expectedOutput": {
        "javascript": "1000",
        "python": "1000",
        "java": "1000"
      }
    },
    {
      "input": "args = [-999,-1]",
      "expectedOutput": {
        "javascript": "-1000",
        "python": "-1000",
        "java": "-1000"
      }
    },
    {
      "input": "args = [0,1]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    },
    {
      "input": "args = [1,0]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    },
    {
      "input": "args = [5,-3]",
      "expectedOutput": {
        "javascript": "2",
        "python": "2",
        "java": "2"
      }
    },
    {
      "input": "args = [-5,3]",
      "expectedOutput": {
        "javascript": "-2",
        "python": "-2",
        "java": "-2"
      }
    },
    {
      "input": "args = [1000,0]",
      "expectedOutput": {
        "javascript": "1000",
        "python": "1000",
        "java": "1000"
      }
    },
    {
      "input": "args = [0,1000]",
      "expectedOutput": {
        "javascript": "1000",
        "python": "1000",
        "java": "1000"
      }
    }
  ]
}
