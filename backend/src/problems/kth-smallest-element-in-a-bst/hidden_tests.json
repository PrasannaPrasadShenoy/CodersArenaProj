{
  "tests": [
    {
      "input": "args = [[2,1,3],2]",
      "expectedOutput": {
        "javascript": "2",
        "python": "2",
        "java": "2"
      }
    },
    {
      "input": "args = [[4,2,6,1,3,5,7],4]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    },
    {
      "input": "args = [[1,null,2],2]",
      "expectedOutput": {
        "javascript": "2",
        "python": "2",
        "java": "2"
      }
    },
    {
      "input": "args = [[5,3,6,2,4,null,null,1],1]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    },
    {
      "input": "args = [[5,3,6,2,4,null,null,1],4]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    },
    {
      "input": "args = [[10,5,15,3,7,12,20],1]",
      "expectedOutput": {
        "javascript": "3",
        "python": "3",
        "java": "3"
      }
    },
    {
      "input": "args = [[10,5,15,3,7,12,20],7]",
      "expectedOutput": {
        "javascript": "20",
        "python": "20",
        "java": "20"
      }
    },
    {
      "input": "args = [[1,null,2,null,3],3]",
      "expectedOutput": {
        "javascript": "3",
        "python": "3",
        "java": "3"
      }
    },
    {
      "input": "args = [[3,1,4,null,2],4]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    }
  ]
}
