        "python": "[[2, 2, 3], [7]]",
        "java": "[[2, 2, 3], [7]]"
      }
    },
    {
      "input": "args = [[2,3,5],8]",
      "expectedOutput": {
        "javascript": "[[2,2,2,2],[2,3,3],[3,5]]",
