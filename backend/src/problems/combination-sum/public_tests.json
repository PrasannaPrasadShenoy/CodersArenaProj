      }
    },
    {
      "input": "args = [[2],1]",
      "expectedOutput": {
        "javascript": "[]",
        "python": "[]",
        "java": "[]"
      }
    }
  ],
  "combinedExpectedOutput": {
    "javascript": "[[2,2,3],[7]]\n[[2,2,2,2],[2,3,3],[3,5]]\n[]",
    "python": "[[2, 2, 3], [7]]\n[[2, 2, 2, 2], [2, 3, 3], [3, 5]]\n[]",
