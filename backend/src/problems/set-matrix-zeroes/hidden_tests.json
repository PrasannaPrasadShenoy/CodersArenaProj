{
  "tests": [
    {
      "input": "args = [[[0]]]",
      "expectedOutput": {
        "javascript": "[[0]]",
        "python": "[[0]]",
        "java": "[[0]]"
      }
    },
    {
      "input": "args = [[[1,0]]]",
      "expectedOutput": {
        "javascript": "[[0,0]]",
        "python": "[[0, 0]]",
        "java": "[[0, 0]]"
      }
    },
    {
      "input": "args = [[[0,1]]]",
      "expectedOutput": {
        "javascript": "[[0,0]]",
        "python": "[[0, 0]]",
        "java": "[[0, 0]]"
      }
    },
    {
      "input": "args = [[[1,2,3],[4,5,6],[7,8,9]]]",
      "expectedOutput": {
        "javascript": "[[1,2,3],[4,5,6],[7,8,9]]",
        "python": "[[1, 2, 3], [4, 5, 6], [7, 8, 9]]",
        "java": "[[1, 2, 3], [4, 5, 6], [7, 8, 9]]"
      }
    },
    {
      "input": "args = [[[1,2,0],[4,5,6],[7,8,9]]]",
      "expectedOutput": {
        "javascript": "[[0,0,0],[4,5,0],[7,8,0]]",
        "python": "[[0, 0, 0], [4, 5, 0], [7, 8, 0]]",
        "java": "[[0, 0, 0], [4, 5, 0], [7, 8, 0]]"
      }
    },
    {
      "input": "args = [[[0,2,3],[4,5,6],[7,8,9]]]",
      "expectedOutput": {
        "javascript": "[[0,0,0],[0,5,6],[0,8,9]]",
        "python": "[[0, 0, 0], [0, 5, 6], [0, 8, 9]]",
        "java": "[[0, 0, 0], [0, 5, 6], [0, 8, 9]]"
      }
    },
    {
      "input": "args = [[[1,2,3],[4,0,6],[7,8,0]]]",
      "expectedOutput": {
        "javascript": "[[1,0,0],[0,0,0],[0,0,0]]",
        "python": "[[1, 0, 0], [0, 0, 0], [0, 0, 0]]",
        "java": "[[1, 0, 0], [0, 0, 0], [0, 0, 0]]"
      }
    },
    {
      "input": "args = [[[1,2],[0,4],[5,6]]]",
      "expectedOutput": {
        "javascript": "[[0,2],[0,0],[0,6]]",
        "python": "[[0, 2], [0, 0], [0, 6]]",
        "java": "[[0, 2], [0, 0], [0, 6]]"
      }
    },
    {
      "input": "args = [[[1,2,3],[4,5,6]]]",
      "expectedOutput": {
        "javascript": "[[1,2,3],[4,5,6]]",
        "python": "[[1, 2, 3], [4, 5, 6]]",
        "java": "[[1, 2, 3], [4, 5, 6]]"
      }
    },
    {
      "input": "args = [[[0,2,0],[4,5,6]]]",
      "expectedOutput": {
        "javascript": "[[0,0,0],[0,5,0]]",
        "python": "[[0, 0, 0], [0, 5, 0]]",
        "java": "[[0, 0, 0], [0, 5, 0]]"
      }
    },
    {
      "input": "args = [[[-1,2,3],[4,0,-6]]]",
      "expectedOutput": {
        "javascript": "[[-1,0,3],[0,0,0]]",
        "python": "[[-1, 0, 3], [0, 0, 0]]",
        "java": "[[-1, 0, 3], [0, 0, 0]]"
      }
    },
    {
      "input": "args = [[[1,2,3,4],[0,5,0,7],[8,9,10,11]]]",
      "expectedOutput": {
        "javascript": "[[0,2,0,4],[0,0,0,0],[0,9,0,11]]",
        "python": "[[0, 2, 0, 4], [0, 0, 0, 0], [0, 9, 0, 11]]",
        "java": "[[0, 2, 0, 4], [0, 0, 0, 0], [0, 9, 0, 11]]"
      }
    }
  ]
}
