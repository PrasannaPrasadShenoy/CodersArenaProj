      "expectedOutput": {
        "javascript": "[[1,0,1],[0,0,0],[1,0,1]]",
        "python": "[[1, 0, 1], [0, 0, 0], [1, 0, 1]]",
        "java": "[[1, 0, 1], [0, 0, 0], [1, 0, 1]]"
      }
    },
    {
      "input": "args = [[[0,1,2,0],[3,4,5,2],[1,3,1,5]]]",
      "expectedOutput": {
        "javascript": "[[0,0,0,0],[0,4,5,0],[0,3,1,0]]",
        "python": "[[0, 0, 0, 0], [0, 4, 5, 0], [0, 3, 1, 0]]",
        "java": "[[0, 0, 0, 0], [0, 4, 5, 0], [0, 3, 1, 0]]"
      }
    },
    {
      "input": "args = [[[1]]]",
      "expectedOutput": {
        "javascript": "[[1]]",
        "python": "[[1]]",
        "java": "[[1]]"
      }
    }
  ],
  "combinedExpectedOutput": {
    "javascript": "[[1,0,1],[0,0,0],[1,0,1]]\n[[0,0,0,0],[0,4,5,0],[0,3,1,0]]\n[[1]]",
    "python": "[[1, 0, 1], [0, 0, 0], [1, 0, 1]]\n[[0, 0, 0, 0], [0, 4, 5, 0], [0, 3, 1, 0]]\n[[1]]",
    "java": "[[1, 0, 1], [0, 0, 0], [1, 0, 1]]\n[[0, 0, 0, 0], [0, 4, 5, 0], [0, 3, 1, 0]]\n[[1]]"
