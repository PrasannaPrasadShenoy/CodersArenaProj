{
  "tests": [
    {
      "input": "args = [[1,2,3,1]]",
      "expectedOutput": {
        "javascript": "true",
        "python": "True",
        "java": "true"
      }
    },
    {
      "input": "args = [[1,2,3,4]]",
      "expectedOutput": {
        "javascript": "false",
        "python": "False",
        "java": "false"
      }
    },
    {
      "input": "args = [[1,1,1,3,3,4,3,2,4,2]]",
      "expectedOutput": {
        "javascript": "true",
        "python": "True",
        "java": "true"
      }
    }
  ],
  "combinedExpectedOutput": {
    "javascript": "true\nfalse\ntrue",
    "python": "True\nFalse\nTrue",
    "java": "true\nfalse\ntrue"
  }
}
