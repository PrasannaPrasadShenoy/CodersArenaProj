    ]
  },
  "examples": [
    {
      "input": "strs = [\"eat\",\"tea\",\"tan\",\"ate\",\"nat\",\"bat\"]",
      "output": "[[\"bat\"],[\"nat\",\"tan\"],[\"ate\",\"eat\",\"tea\"]]",
      "explanation": ""
    },
    {
      "input": "strs = [\"\"]",
      "output": "[[\"\"]]",
      "explanation": ""
    },
    {
      "input": "strs = [\"a\"]",
      "output": "[[\"a\"]]",
      "explanation": ""
    }
  ],
  "constraints": [
    "`1 <= strs.length <= 10^4`",
    "`0 <= strs[i].length <= 100`",
    "`strs[i]` consists of lowercase English letters."
  ]
