{
  "tests": [
    {
      "input": "args = [[2,1]]",
      "expectedOutput": {
        "javascript": "1",
        "python": "1",
        "java": "1"
      }
    },
    {
      "input": "args = [[1,2,4,3]]",
      "expectedOutput": {
        "javascript": "4",
        "python": "4",
        "java": "4"
      }
    },
    {
      "input": "args = [[1,3,2,5,25,24,5]]",
      "expectedOutput": {
        "javascript": "24",
        "python": "24",
        "java": "24"
      }
    },
    {
      "input": "args = [[2,3,4,5,18,17,6]]",
      "expectedOutput": {
        "javascript": "17",
        "python": "17",
        "java": "17"
      }
    },
    {
      "input": "args = [[1,2,3,4,5]]",
      "expectedOutput": {
        "javascript": "6",
        "python": "6",
        "java": "6"
      }
    },
    {
      "input": "args = [[5,4,3,2,1]]",
      "expectedOutput": {
        "javascript": "6",
        "python": "6",
        "java": "6"
      }
    },
    {
      "input": "args = [[0,2]]",
      "expectedOutput": {
        "javascript": "0",
        "python": "0",
        "java": "0"
      }
    },
    {
      "input": "args = [[3,9,3,4,7,2,12,6]]",
      "expectedOutput": {
        "javascript": "45",
        "python": "45",
        "java": "45"
      }
    },
    {
      "input": "args = [[1,0,0,0,0,0,0,2,2]]",
