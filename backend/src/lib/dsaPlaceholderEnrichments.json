      }
    }
  },
  "hand-of-straights": {
    "description": "Alice has some number of cards and she wants to rearrange the cards into groups so that each group is of size groupSize, and consists of groupSize consecutive cards. Given an integer array hand and groupSize, return true if she can rearrange the cards, or false otherwise.",
    "descriptionNotes": [],
    "constraints": [
