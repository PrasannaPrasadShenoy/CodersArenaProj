{
  "last-stone-weight": {
    "description": "You have a collection of stones, each with an integer weight. Each turn, pick the two heaviest stones and smash them together. If they are equal, both are destroyed; if not, the heavier stone's weight is reduced by the lighter stone's weight and the result stays in the pile. Return the weight of the last remaining stone, or 0 if none remain.",
    "descriptionNotes": [],
    "constraints": [
      "1 <= stones.length <= 30",
      "1 <= stones[i] <= 1000"
    ],
    "publicTests": {
      "tests": [
        {
          "input": "args = [[2,7,4,1,8,1]]",
          "expectedOutput": {
            "javascript": "1",
            "python": "1",
            "java": "1"
          }
        },
        {
          "input": "args = [[1]]",
          "expectedOutput": {
            "javascript": "1",
            "python": "1",
            "java": "1"
          }
        },
        {
          "input": "args = [[2,2]]",
          "expectedOutput": {
            "javascript": "0",
            "python": "0",
            "java": "0"
          }
        }
      ],
      "combinedExpectedOutput": {
        "javascript": "1\n1\n0",
        "python": "1\n1\n0",
        "java": "1\n1\n0"
      }
    }
  },
  "single-number": {
    "description": "Given a non-empty array of integers nums, every element appears twice except for one. Find that single one. You must implement a solution with linear runtime complexity and use only constant extra space.",
    "descriptionNotes": [],
    "constraints": [
      "1 <= nums.length <= 3 * 10^4",
      "-3 * 10^4 <= nums[i] <= 3 * 10^4",
      "Each element appears twice except for one which appears once."
    ],
    "publicTests": {
      "tests": [
        {
          "input": "args = [[2,2,1]]",
          "expectedOutput": {
            "javascript": "1",
            "python": "1",
            "java": "1"
          }
        },
        {
          "input": "args = [[4,1,2,1,2]]",
          "expectedOutput": {
            "javascript": "4",
            "python": "4",
            "java": "4"
          }
        },
        {
          "input": "args = [[1]]",
          "expectedOutput": {
            "javascript": "1",
            "python": "1",
            "java": "1"
          }
        }
      ],
      "combinedExpectedOutput": {
        "javascript": "1\n4\n1",
        "python": "1\n4\n1",
        "java": "1\n4\n1"
      }
    }
  },
  "happy-number": {
    "description": "Write an algorithm to determine if a number n is happy. A happy number is defined by: replace the number by the sum of the squares of its digits, and repeat until the number equals 1 (happy) or loops endlessly in a cycle which does not include 1 (not happy).",
    "descriptionNotes": [],
    "constraints": [
      "1 <= n <= 2^31 - 1"
    ],
    "publicTests": {
      "tests": [
        {
          "input": "args = [19]",
          "expectedOutput": {
            "javascript": "true",
            "python": "True",
            "java": "true"
          }
        },
        {
          "input": "args = [2]",
          "expectedOutput": {
            "javascript": "false",
            "python": "False",
            "java": "false"
          }
        },
        {
          "input": "args = [7]",
          "expectedOutput": {
            "javascript": "true",
            "python": "True",
            "java": "true"
          }
        }
      ],
      "combinedExpectedOutput": {
        "javascript": "true\nfalse\ntrue",
        "python": "True\nFalse\nTrue",
        "java": "true\nfalse\ntrue"
      }
    }
  },
  "multiply-strings": {
    "description": "Given two non-negative integers num1 and num2 represented as strings, return the product of num1 and num2, also represented as a string. You must not use any built-in BigInteger library or convert the inputs to integer directly.",
    "descriptionNotes": [],
    "constraints": [
      "1 <= num1.length, num2.length <= 200",
      "num1 and num2 consist of digits only.",
      "Both num1 and num2 do not contain any leading zero, except the string \"0\" itself."
    ],
    "publicTests": {
      "tests": [
        {
          "input": "args = [\"2\",\"3\"]",
          "expectedOutput": {
            "javascript": "6",
            "python": "6",
            "java": "6"
          }
        },
        {
          "input": "args = [\"123\",\"456\"]",
          "expectedOutput": {
            "javascript": "56088",
            "python": "56088",
            "java": "56088"
          }
        },
        {
          "input": "args = [\"0\",\"9999\"]",
          "expectedOutput": {
            "javascript": "0",
            "python": "0",
            "java": "0"
          }
        }
      ],
      "combinedExpectedOutput": {
        "javascript": "6\n56088\n0",
        "python": "6\n56088\n0",
        "java": "6\n56088\n0"
      }
    }
  },
  "powx-n": {
    "description": "Implement pow(x, n), which calculates x raised to the power n (i.e., x^n).",
    "descriptionNotes": [],
    "constraints": [
      "-100.0 < x < 100.0",
      "-2^31 <= n <= 2^31 - 1",
      "n is an integer.",
      "-10^4 <= x^n <= 10^4"
    ],
    "publicTests": {
      "tests": [
        {
          "input": "args = [2,10]",
          "expectedOutput": {
            "javascript": "1024",
            "python": "1024.0",
            "java": "1024.0"
          }
        },
        {
          "input": "args = [2.1,3]",
          "expectedOutput": {
            "javascript": "9.261",
            "python": "9.261",
            "java": "9.261"
          }
        },
        {
          "input": "args = [2,-2]",
          "expectedOutput": {
            "javascript": "0.25",
            "python": "0.25",
            "java": "0.25"
          }
        }
      ],
      "combinedExpectedOutput": {
        "javascript": "1024\n9.261\n0.25",
        "python": "1024.0\n9.261\n0.25",
        "java": "1024.0\n9.261\n0.25"
      }
    }
  },
  "plus-one": {
    "description": "You are given a large integer represented as an integer array digits, where each digits[i] is the ith digit of the integer. Increment the large integer by one and return the resulting array of digits.",
    "descriptionNotes": [],
    "constraints": [
      "1 <= digits.length <= 100",
      "0 <= digits[i] <= 9",
      "digits does not contain leading zeros."
    ],
    "publicTests": {
      "tests": [
        {
          "input": "args = [[1,2,3]]",
          "expectedOutput": {
            "javascript": "[1,2,4]",
            "python": "[1, 2, 4]",
            "java": "[1, 2, 4]"
          }
        },
        {
          "input": "args = [[9]]",
          "expectedOutput": {
            "javascript": "[1,0]",
            "python": "[1, 0]",
            "java": "[1, 0]"
          }
        },
        {
          "input": "args = [[9,9]]",
          "expectedOutput": {
            "javascript": "[1,0,0]",
            "python": "[1, 0, 0]",
            "java": "[1, 0, 0]"
          }
        }
      ],
      "combinedExpectedOutput": {
        "javascript": "[1,2,4]\n[1,0]\n[1,0,0]",
        "python": "[1, 2, 4]\n[1, 0]\n[1, 0, 0]",
        "java": "[1, 2, 4]\n[1, 0]\n[1, 0, 0]"
      }
    }
  },
  "minimum-interval-to-include-each-query": {
    "description": "You are given a 2D integer array intervals where intervals[i] = [l_i, r_i] represent an inclusive interval. You are also given an integer array queries. For each query j, find the size of the smallest interval i such that l_i <= queries[j] <= r_i. If no such interval exists, store -1.",
    "descriptionNotes": [],
    "constraints": [
      "1 <= intervals.length, queries.length <= 10^5",
      "intervals[i].length == 2",
      "1 <= l_i <= r_i <= 10^7",
      "1 <= queries[j] <= 10^7"
    ],
    "publicTests": {
      "tests": [
        {
          "input": "args = [[[1,4],[2,3],[3,4]],[3,4,5]]",
          "expectedOutput": {
            "javascript": "[2,1,-1]",
            "python": "[2, 1, -1]",
            "java": "[2, 1, -1]"
          }
        }
      ],
      "combinedExpectedOutput": {
        "javascript": "[2,1,-1]",
        "python": "[2, 1, -1]",
        "java": "[2, 1, -1]"
      }
    }
  },
  "valid-parenthesis-string": {
    "description": "Given a string s containing only '(', ')' and '*', determine if the string is valid. '*' can be treated as '(', ')' or an empty string.",
    "descriptionNotes": [],
    "constraints": [
      "1 <= s.length <= 100",
      "s[i] is '(', ')' or '*'."
    ],
    "publicTests": {
      "tests": [
        {
          "input": "args = [\"(**)\"]",
          "expectedOutput": {
            "javascript": "true",
            "python": "True",
            "java": "true"
          }
        },
        {
          "input": "args = [\"(*)\"]",
          "expectedOutput": {
            "javascript": "true",
            "python": "True",
            "java": "true"
          }
        },
        {
          "input": "args = [\"(*)))\"]",
          "expectedOutput": {
            "javascript": "false",
            "python": "False",
            "java": "false"
          }
        }
      ],
      "combinedExpectedOutput": {
        "javascript": "true\ntrue\nfalse",
        "python": "True\nTrue\nFalse",
        "java": "true\ntrue\nfalse"
      }
    }
  },
  "partition-labels": {
    "description": "You are given a string s. We want to partition the string into as many parts as possible so that each letter appears in at most one part. Return a list of integers representing the size of these parts.",
    "descriptionNotes": [],
    "constraints": [
      "1 <= s.length <= 500",
      "s consists of lowercase English letters."
    ],
    "publicTests": {
      "tests": [
        {
          "input": "args = [\"ababcbacadefegdehijhklij\"]",
